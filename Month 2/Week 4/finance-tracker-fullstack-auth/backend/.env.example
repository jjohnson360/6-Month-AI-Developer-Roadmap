# -----------------------------------------------------------
# Finance Tracker Backend — Environment Variables
# Copy this file to .env and fill in real values for local dev.
# On Render (or other platforms), set these as "Environment Variables"
# in the dashboard — never commit a real .env to version control.
# -----------------------------------------------------------

# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string. Render auto-sets this when you
# attach a Postgres database. Omit to use SQLite locally.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT Security ────────────────────────────────────────────
# Generate a strong random key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API.
# Local dev defaults are pre-configured in code; only set this in production.
# ALLOWED_ORIGINS=https://your-frontend.onrender.com
