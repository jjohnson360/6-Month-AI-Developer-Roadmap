# -----------------------------------------------------------
# Finance Tracker Frontend — Environment Variables
# Copy this file to .env for local dev, or set these in your
# hosting platform's dashboard (e.g. Render > Environment).
# -----------------------------------------------------------

# ── Backend URL ─────────────────────────────────────────────
# Leave empty for local dev (Vite proxy handles /api/* → :8000)
# Set to your deployed backend URL in production, WITHOUT a trailing slash.
# Example: VITE_BACKEND_URL=https://finance-tracker-api.onrender.com
VITE_BACKEND_URL=
